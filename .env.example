# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<generate-with-openssl-rand-base64-24>
POSTGRES_DB=securesign

# Backend - JWT (generate with: openssl rand -hex 64)
SECRET_KEY=<your-512-bit-secret-key-in-hex>
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Backend - AES Encryption (generate with: openssl rand -hex 32)
AES_KEY=<your-256-bit-aes-key-in-hex>

# Backend - App Config
APP_NAME=SecureSign
APP_VERSION=1.0.0
DEBUG=false

# Backend - CA Configuration
CA_COUNTRY=EC
CA_STATE=Pichincha
CA_LOCALITY=Quito
CA_ORG=ESPE
CA_ORG_UNIT=Seguridad
CA_COMMON_NAME=CA_SIMULADA
CA_VALIDITY_DAYS=365

# Admin account (created on startup)
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Administrador

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# MinIO
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=securesign-documents
