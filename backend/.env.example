# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/securesign

# JWT
SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# AES Encryption (for storing private keys)
AES_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# App
APP_NAME=SecureSign
APP_VERSION=1.0.0
DEBUG=true

# CA Configuration
CA_COUNTRY=EC
CA_STATE=Pichincha
CA_LOCALITY=Quito
CA_ORG=ESPE
CA_ORG_UNIT=Seguridad
CA_COMMON_NAME=CA_SIMULADA
CA_VALIDITY_DAYS=365
